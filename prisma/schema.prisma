generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Tabel USERS
model users {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar
  password_hash String    @db.VarChar
  full_name     String    @db.VarChar
  last_login    DateTime? @db.Timestamp
  created_at    DateTime  @default(now()) @db.Timestamp

  devices       devices[] // Relasi ke tabel devices
}

// 2. Tabel DEVICES
model devices {
  id                  String    @id @default(uuid()) @db.Uuid
  device_name         String    @db.VarChar
  location            String    @db.VarChar
  mac_address         String    @unique @db.VarChar
  is_active           Boolean   @default(true)
  registered_by       String    @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamp
  last_alert_at       DateTime? @db.Timestamptz // Waktu email peringatan terakhir (cooldown)
  last_alert_status   String?                   // Status saat email terakhir dikirim (deteksi eskalasi)
  filter_installed_at DateTime? @db.Timestamptz // Waktu filter terakhir dipasang
  inlet_distance_cm   Float     @default(5)     // Jarak inlet yang direkomendasikan dari titik solder

  user                users     @relation(fields: [registered_by], references: [id], onDelete: Cascade)
  sensor_logs         sensor_logs[]
}

// 3. Tabel SENSOR_LOGS
model sensor_logs {
  id                  BigInt    @id @default(autoincrement())
  device_id           String    @db.Uuid
  tvoc_raw_ppb        Float                     // TVOC mentah dari SGP30
  tvoc_kalman_ppb     Float?                    // TVOC setelah Kalman filter di ESP32
  eco2_ppm            Float
  dust_outlet_ugm3    Float?                    // Debu di outlet (GP2Y), indikator efektivitas filter
  temperature_celsius Float
  humidity_percent    Float
  air_status          String    @default("AMAN") // Keluaran fuzzy ESP32: AMAN | WASPADA | BERBAHAYA
  fuzzy_level         String?                   // MIN | LOW | MED | FAST
  fan_duty_percent    Float                     // 0–100 %
  fan_rpm             Int?                      // Dari sinyal tacho kipas
  recorded_at         DateTime  @default(now()) @db.Timestamptz

  device              devices   @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id, recorded_at])
}