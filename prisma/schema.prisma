generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Tabel USERS
model users {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar
  password_hash String    @db.VarChar
  full_name     String    @db.VarChar
  role          String    @default("pengelola") @db.VarChar // Saat ini hanya "pengelola"; role lain bisa ditambah nanti
  last_login    DateTime? @db.Timestamp
  created_at    DateTime  @default(now()) @db.Timestamp

  devices         devices[] @relation("DeviceRegistrar")  // Device yang didaftarkan user ini
  filter_installs devices[] @relation("FilterInstaller")  // Penggantian filter yang dicatat user ini
}

// 2. Tabel DEVICES
model devices {
  id                  String    @id @default(uuid()) @db.Uuid
  device_name         String    @db.VarChar
  location            String    @db.VarChar
  mac_address         String    @unique @db.VarChar
  is_active           Boolean   @default(true)
  registered_by       String    @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamp
  last_alert_at       DateTime? @db.Timestamptz // Waktu email peringatan terakhir (cooldown)
  last_alert_status   String?                   // Status saat email terakhir dikirim (deteksi eskalasi)
  filter_installed_at DateTime? @db.Timestamptz // Waktu filter terakhir dipasang
  filter_installed_by String?   @db.Uuid        // User yang mencatat penggantian filter terakhir
  inlet_distance_cm   Float     @default(5)     // Jarak inlet yang direkomendasikan dari titik solder

  user                users     @relation("DeviceRegistrar", fields: [registered_by], references: [id], onDelete: Cascade)
  filter_installer    users?    @relation("FilterInstaller", fields: [filter_installed_by], references: [id], onDelete: SetNull)
  sensor_logs         sensor_logs[]
  sensor_hourly       sensor_hourly[]
}

// 3. Tabel SENSOR_LOGS
model sensor_logs {
  id                  BigInt    @id @default(autoincrement())
  device_id           String    @db.Uuid
  tvoc_raw_ppb        Float                     // TVOC mentah dari SGP30
  tvoc_kalman_ppb     Float?                    // TVOC setelah Kalman filter di ESP32 (absolut = baseline + estimasi)
  tvoc_baseline_ppb   Float?                    // Baseline udara bersih yang direkam ESP32 saat menyala
  eco2_ppm            Float
  dust_outlet_ugm3    Float?                    // Debu di outlet (GP2Y), indikator efektivitas filter
  temperature_celsius Float?                    // null kalau SHT31 gagal dibaca
  humidity_percent    Float?                    // null kalau SHT31 gagal dibaca
  air_status          String    @default("AMAN") // Keluaran fuzzy ESP32: AMAN | WASPADA | BERBAHAYA
  fan_duty_percent    Float                     // 0–100 %, keluaran fuzzy Sugeno (kontinu)
  fan_rpm             Int?                      // Dari sinyal tacho kipas
  recorded_at         DateTime  @default(now()) @db.Timestamptz

  device              devices   @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id, recorded_at])
}

// Percobaan login yang GAGAL, untuk rate limit (lib/rate-limit.ts). Hanya kegagalan yang dicatat;
// login berhasil menghapus catatan email itu. Catatan > 1 hari dibersihkan cron retensi harian.
model login_failures {
  id         BigInt   @id @default(autoincrement())
  email      String   @db.VarChar // email yang dicoba (huruf kecil), terdaftar maupun tidak
  ip         String   @db.VarChar
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([ip, created_at])
  @@index([email, created_at])
}

// MAC yang mengirim data tapi belum terdaftar di devices — ditampilkan di halaman Kelola Alat
// sebagai "Alat baru terdeteksi" supaya bisa didaftarkan tanpa mengetik MAC.
model unregistered_macs {
  mac_address   String   @id @db.VarChar
  first_seen_at DateTime @default(now()) @db.Timestamptz
  last_seen_at  DateTime @default(now()) @db.Timestamptz
  attempts      Int      @default(1)
}

// 4. Tabel SENSOR_HOURLY — ringkasan per jam dari sensor_logs yang sudah melewati masa retensi.
// Diisi oleh scripts/retention.ts. TVOC memakai nilai Kalman, atau nilai mentah kalau Kalman kosong.
model sensor_hourly {
  device_id               String   @db.Uuid
  hour_start              DateTime @db.Timestamptz // Awal jam (dibulatkan ke bawah)
  samples                 Int                      // Jumlah log dalam jam ini
  fan_running_samples     Int                      // Log dengan fan_duty_percent > 0 (untuk jam operasi filter)
  tvoc_avg_ppb            Float
  tvoc_max_ppb            Float
  tvoc_raw_max_ppb        Float
  dust_outlet_avg_ugm3    Float?
  dust_outlet_max_ugm3    Float?
  temperature_avg_celsius Float?
  humidity_avg_percent    Float?
  aman_samples            Int
  waspada_samples         Int
  berbahaya_samples       Int

  device                  devices  @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@id([device_id, hour_start])
}